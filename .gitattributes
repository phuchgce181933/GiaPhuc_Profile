# Auto detect text files and normalize line endings to LF
* text=auto

# Force LF for shell scripts, Node.js scripts, and PlantUML (Unix convention)
*.sh              text eol=lf
*.bash            text eol=lf
*.js              text eol=lf
*.puml            text eol=lf
*.md              text eol=lf

# Force CRLF for Windows-specific scripts
*.ps1             text eol=crlf
*.bat             text eol=crlf

# YAML files (used in some CI configs)
*.yml             text eol=lf
*.yaml            text eol=lf

# Don't modify these
*.png             binary
*.jpg             binary
*.gif             binary
*.ico             binary